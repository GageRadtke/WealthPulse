# Root Git ignore for WealthPulse

# Environment and secrets
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.p12
*.jks
*.keystore
*.crt
*.cer
*.pfx
*.secret
*.token
npmrc
**/.npmrc
**/.yarnrc
**/.yarnrc.yml

# Node / frontend build artifacts
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/blob-report/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Java / backend build artifacts
**/target/
**/build/
**/out/
**/*.class
**/*.jar
**/*.war
**/*.ear
.classpath
.project
.settings/
*.hprof
*.dumpstream
*.dump.tmp
**/surefire-reports/
**/failsafe-reports/

# Database credentials, local data, and backups
.pgpass
pgpass.conf
.psql_history
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db
database-backups/
db-backups/
backups/
backup/

# Local application storage
uploads/
backend/uploads/

# IDEs and editors
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.njsproj.user
*.sln
*.sw?
*.iml

# OS / tooling
*.log
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.cache
.cache/
.eslintcache
.stylelintcache
.tags
*.pid
*.seed
*.pid.lock

# Application-specific
spring.log
hs_err_pid*

# Ignore local script output if any
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local


# Optional generated dependency lock
npm-shrinkwrap.json

